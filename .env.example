# =============================================================================
# StockSmart — example environment. Copy to .env and fill real values.
# NEVER commit .env with real secrets (it is git-ignored).
# `docker compose` reads .env automatically from the project root.
# =============================================================================

# --- Oracle (primary database) ---
# DB_HOST is used by a NATIVE backend run (mvn spring-boot:run).
# Inside Docker Compose the backend always connects to the `oracle` service.
DB_HOST=localhost
DB_PORT=1521
# XEPDB1 for Oracle XE (default image); FREEPDB1 when using the arm64 override.
DB_SERVICE=XEPDB1
DB_USERNAME=stocksmart
# REQUIRED by docker compose (no usable default). Pick a real password.
DB_PASSWORD=change-me

# --- JWT (REQUIRED by docker compose; generate a fresh one per environment) ---
# Example generation: openssl rand -base64 48
# The value below is the public development fallback — fine for local demos ONLY.
JWT_SECRET=c3RvY2tzbWFydC1kZXYtand0LXNlY3JldC0wMTIzNDU2Nzg5YWJjZGVmZ2hpamtsbW5vcA==
JWT_EXPIRATION=86400000

# --- Frontend origin (used for CORS when CORS_ALLOWED_ORIGINS is unset) ---
FRONTEND_URL=http://localhost:4200

# --- CORS (comma-separated allowed origins; wins over FRONTEND_URL when set) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Demo seed users (dev only; set APP_SEED_ENABLED=false in prod) ---
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Admin@123

# --- Docker Compose presentation/runtime knobs ---
# Host port the Angular/Nginx frontend is published on.
FRONTEND_PORT=4200
# Nginx upstream for /api/* inside the compose network (container-to-container).
BACKEND_URL=backend:8080
# Image tag used for the built backend/frontend images.
IMAGE_TAG=dev

# =============================================================================
# StockSmart — example environment. Copy to .env and fill real values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- Oracle ---
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USERNAME=stocksmart
DB_PASSWORD=change-me

# --- JWT (generate a fresh >=256-bit Base64 secret for every environment) ---
# Example generation: openssl rand -base64 48
JWT_SECRET=c3RvY2tzbWFydC1kZXYtand0LXNlY3JldC0wMTIzNDU2Nzg5YWJjZGVmZ2hpamtsbW5vcA==
JWT_EXPIRATION=86400000

# --- CORS (comma-separated allowed origins for the Angular app) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Demo seed users (dev only; set APP_SEED_ENABLED=false in prod) ---
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Admin@123
